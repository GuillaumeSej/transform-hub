# Local port. Render sets PORT itself in production — this default is for `npm run dev` only.
PORT=8080

# Comma-separated list of origins allowed to call this API (CORS). Required in production
# (NODE_ENV=production) — the server refuses to start without it. In non-production, if left
# unset, all origins are allowed (dev convenience only).
# Example: ALLOWED_ORIGIN=https://yourname.github.io,http://localhost:3000
ALLOWED_ORIGIN=http://localhost:3000

# Firebase service account credentials, as a SINGLE-LINE JSON string.
# How to obtain it: Firebase Console → Project Settings → Service Accounts → Generate new private
# key. This downloads a .json file — collapse it to one line (e.g. `JSON.stringify(require("./key.json"))`
# in a Node REPL, or `jq -c . key.json`) and paste the result here as one string. Never commit the
# original .json file to the repo.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...", "...": "..."}
